# Copy to env.tfvars (git-ignored) and adapt to the hosting cloud.
external_network = "public"
egress_network   = null      # an external network for the default route, when the SSH network has no Internet access
az               = "nova"
image            = "ubuntu-24.04"
flavor           = "m1.xlarge-32g"   # 8 vCPUs, 32 GB of RAM, 100 GB local disk
network_mtu      = null      # the MTU your tenant networks need, if smaller than the default
dns_nameservers  = ["9.9.9.9"]
ssh_sources      = ["198.51.100.0/24"]
ssh_public_key   = "ssh-ed25519 AAAA... stack@bench"
